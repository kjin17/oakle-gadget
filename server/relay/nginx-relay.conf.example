# oakle 중계 서버 nginx 예시. relay.example.com 을 자기 도메인으로 바꾼다.
# 인증서: sudo certbot --nginx -d relay.example.com   (펌웨어 relay_ca.h 는 Let's Encrypt 루트를 믿는다)

limit_req_zone $binary_remote_addr zone=oakle_relay:1m rate=30r/m;   # 기기 한도와 별도로 IP 단위 무차별 시도 차단
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# 접근 로그엔 경로·상태·크기·시간만. Authorization·X-Oakle-* 헤더와 본문은 남기지 않는다
log_format oakle_relay '$time_iso8601 $remote_addr "$request_method $uri" $status $request_length $body_bytes_sent $request_time';

server {
    listen 443 ssl;
    http2 on;
    server_name relay.example.com;                     

    ssl_certificate     /etc/letsencrypt/live/relay.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;

    access_log /var/log/nginx/oakle-relay.access.log oakle_relay;
    client_max_body_size 1m;                             # /v1/ask 15초 WAV ≈ 480KB. /v1/turn 은 중계가 64KB 로 자른다

    # 기기 → 중계 (텍스트·도구 왕복, 음성)
    location ~ ^/v1/(turn|ask)$ {
        limit_req zone=oakle_relay burst=10 nodelay;
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 160s;                         # 중계 TURN_TIMEOUT 120s / ASK_TIMEOUT 150s 보다 길게
        proxy_request_buffering on;
    }

    # 집 PC 커넥터 → 중계 (밖으로 여는 WebSocket 1개)
    location = /v1/connect {
        limit_req zone=oakle_relay burst=5 nodelay;
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;                        # 중계가 20초마다 ping 을 보낸다
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /healthz { proxy_pass http://127.0.0.1:8766; }
    location / { return 404; }
}

server {
    listen 80;
    server_name relay.example.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
