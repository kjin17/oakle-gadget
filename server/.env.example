# server/.env 로 복사해서 쓴다(.gitignore 대상). voice_bridge.py 는 .env 를 직접 읽지 않으니 셸에서 불러온다:
#   set -a; . server/.env; set +a; python3 server/voice_bridge.py
# 비밀값(토큰·키)은 여기 말고 CRED_DIR 의 파일에 둔다(server/README.md 「비밀값」).

PROFILE=home
BIND=192.0.2.10            # 이 PC 의 LAN IP(예시 주소). 0.0.0.0 으로 열지 말 것
PORT=8765
STATE_DIR=~/.local/share/oakle-gadget
# CRED_DIR=~/.openclaw/credentials

# STT: whisper_cpp(기본, brew install whisper-cpp) | mlx
STT=whisper_cpp
WHISPER_MODEL=~/models/ggml-large-v3-turbo.bin

# LLM: cli(설정 변경 없이 openclaw agent CLI) | http(Gateway /v1/chat/completions, 설정에서 켜야 함)
LLM=cli
VOICE_AGENT=main
# OPENCLAW_BIN=/opt/homebrew/bin/openclaw   # LaunchAgent 처럼 PATH 가 짧은 환경에선 절대경로로
# OPENCLAW_URL=http://127.0.0.1:18789

# TTS: macOS say
SAY_VOICE=Yuna
TTS_PEAK_DBFS=-1

DEVICE_ACTIONS=1           # IR 표지 → X-Oakle-Action (집 모드 기본 켜짐)
DAILY_LIMIT=500
LOG_TEXT=0                 # 1 이면 질의·답 원문을 로그에 남긴다(기본 안 남김)
